[Unit]
Description=AI Auditor API (uvicorn)
After=network-online.target postgresql.service redis.service

[Service]
Type=exec
User=auditor
WorkingDirectory=/opt/ai-auditor
EnvironmentFile=/opt/ai-auditor/deploy/auditor.env
ExecStart=/opt/ai-auditor/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8300 --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
