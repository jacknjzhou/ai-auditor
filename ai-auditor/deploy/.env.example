# ai-auditor 容器化部署环境变量模板
# 用法：cp .env.example .env —— 修改全部 change-me 密钥后再启动！
# 注意：必填项在 docker-compose.yml 中用 ${VAR:?...} 做了快速失败，缺失会直接报错。

# ==================== 数据层（必改）====================
POSTGRES_PASSWORD=change-me-pg
REDIS_PASSWORD=change-me-redis

# ==================== 入站鉴权（必改）====================
# 兜底 HMAC 密钥；正式接入时每个 connector 可在 connector_config.webhook_secret 单独配置
AUDITOR_WEBHOOK_SECRET_DEFAULT=change-me-hmac
# 时间戳防重放窗口（秒）
AUDITOR_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# ==================== 宿主机端口 ====================
AUDITOR_EXPOSE_PORT=8300
# Adminer（--profile tools 时生效）
AUDITOR_ADMINER_PORT=8301

# ==================== 执行内核（P3.0）====================
# false = legacy 硬编码流水线（默认）；true = Planner→Harness→Composer 三层内核
AUDITOR_KERNEL_MODE=false
# human_gate 一次 run 最多挂起-恢复轮次（防死循环）
AUDITOR_MAX_SUSPEND_ROUNDS=3

# ==================== 新流接入默认档位（config/sops 装载）====================
# 仅对**新建** flow 生效；已存在 flow 保留其运营侧已调整的档位（--force 可覆盖）
AUDITOR_SOP_MODE=advisory                 # shadow|advisory|semi_auto|full_auto
AUDITOR_SOP_WRITEBACK_TIER=COMMENT_ONLY   # FULL_API|COMMENT_ONLY|IM_ONLY

# ==================== LLM 模型网关（NewAPI，OpenAI 兼容）====================
AUDITOR_LLM_ENABLED=false                 # 开链前先影子评测，一致率达标再放量
AUDITOR_LLM_BASE_URL=http://10.26.8.43:3002/v1
AUDITOR_LLM_API_KEY=
AUDITOR_LLM_MODEL=gpt-4o-mini

# ==================== 制度知识库 RAG ====================
AUDITOR_RAG_ENABLED=false
AUDITOR_EMBEDDING_MODEL=text-embedding-3-small

# ==================== 决策矩阵阈值（0~1）====================
AUDITOR_CONF_HIGH=0.90
AUDITOR_CONF_LOW=0.60
